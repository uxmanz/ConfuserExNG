<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>Confuser.QuickTool</RootNamespace>
    <AssemblyName>Confuser.QuickTool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Resource\ConfuserExNG.ico</ApplicationIcon>
    <!-- Build straight into the release folder next to Confuser.CLI.exe,
         exactly like the other tools. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\Release\bin\</OutputPath>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
  </ItemGroup>

  <!-- Confuser.Core is built by the same toolchain as the CLI into Release\bin
       (its project is classic .NET Framework 4.8 and cannot be built on Linux).
       Referencing the built assembly keeps this project buildable everywhere:
       on Linux, drop Confuser.Core.dll and dnlib.dll from a ConfuserExNG release
       zip into Release\bin, then `dotnet build` this project. -->
  <ItemGroup>
    <Reference Include="Confuser.Core">
      <HintPath>..\Release\bin\Confuser.Core.dll</HintPath>
    </Reference>
    <Reference Include="dnlib">
      <HintPath>..\Release\bin\dnlib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\Resource\ConfuserExNG_32.png" Link="ConfuserExNG_32.png" />
  </ItemGroup>

  <!-- The classic project shipped a hand-written AssemblyInfo. -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
